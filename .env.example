# Public origin (the custom domain once connected) used for canonical URLs, OpenGraph,
# sitemap, robots.txt, JSON-LD and the CV PDF. On Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL. NEXT_PUBLIC_SITE_URL is still read as an alias.
SITE_URL=https://example.com

# Search indexing follows VERCEL_ENV: production is indexed (allow-all robots.txt, no noindex);
# preview deployments and local builds get noindex + Disallow: /.
# Set to "false" to keep production hidden too; off Vercel, set to "true" to allow indexing.
ENABLE_INDEXING=

# Public contact details. Empty values are hidden across the site, footer and CV PDF.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ORCID_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form delivery (Resend) and spam protection (Cloudflare Turnstile).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Nimra Zahid website <hello@example.com>"
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Writing studio (Keystatic). Locally the editor at /keystatic saves to files in the repo.
# In production it is disabled unless a Keystatic Cloud project ("team/project") is set.
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=
