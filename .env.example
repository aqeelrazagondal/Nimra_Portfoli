# Canonical production origin used for canonical URLs, OpenGraph, sitemap and JSON-LD.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://example.com

# Search indexing. Leave unset until the content is approved. Even when "true",
# indexing stays off on Vercel preview deployments (VERCEL_ENV=preview).
ENABLE_INDEXING=

# Public contact details. Empty values are hidden across the site, footer and CV PDF.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ORCID_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Contact form delivery (Resend) and spam protection (Cloudflare Turnstile).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend, e.g. "Nimra Zahid website <hello@example.com>"
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Writing studio. Development is local; production uses this repository on GitHub.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Only the one-time `npm run dev:github` setup command sets the setup override.
